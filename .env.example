# ── Firebase web app config ─────────────────────────────────────────
# Firebase Console → Project settings → Your apps → (your web app) → firebaseConfig
# These are safe for the browser — that's what the NEXT_PUBLIC_ prefix means.
NEXT_PUBLIC_FIREBASE_API_KEY= AIzaSyA5lFaJYrxpGOqAGKyaAWtT6axvlTxz--o
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN= jt-boilerpoint.firebaseapp.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID= 671704149856
NEXT_PUBLIC_FIREBASE_APP_ID= 1:671704149856:web:35cc2e2d569569c2593805
# Optional — only if Google Analytics is enabled on the web app
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID= G-R5N4CMY0X1

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=jt-boilerpoint

# ── Backend API ─────────────────────────────────────────────────────
# Allowed CORS origin for /api (empty = all cross-origin requests denied)
CORS_ORIGIN=
# Local port for the Functions API
PORT=5001

# ── Claude Code MCP (optional) ──────────────────────────────────────
# Google Stitch design-to-code — https://stitch.withgoogle.com/settings
STITCH_API_KEY=

// Initialize Firebase
const app = initializeApp(firebaseConfig);
const analytics = getAnalytics(app);